# Base de datos. SQLite local por defecto.
# Para PostgreSQL: postgresql://usuario:clave@host:5432/prestige (ver README)
DATABASE_URL="file:./prisma/dev.db"

# Zona horaria de la barbería (define qué es "hoy" y qué horas ya pasaron)
SHOP_TIMEZONE="America/Santiago"

# Panel de métricas en /dashboard. Si se define, se entra con /dashboard?key=<valor>
DASHBOARD_KEY=

# Panel de administración en /admin (precios, barberos, horarios, promociones, productos).
# Si se define, se entra con esta clave. Sin clave: abierto en desarrollo y deshabilitado (404) en producción.
ADMIN_KEY=

# URL de un backend externo para la API. Vacío = las rutas /api de este mismo proyecto.
NEXT_PUBLIC_API_URL=

# Envío de correos de confirmación (https://resend.com)
# Sin RESEND_API_KEY los correos se simulan y se registran en la consola del servidor.
RESEND_API_KEY=
# Remitente verificado en Resend. onboarding@resend.dev solo envía al correo de tu cuenta Resend.
BOOKING_EMAIL_FROM="Prestige Barber <onboarding@resend.dev>"
